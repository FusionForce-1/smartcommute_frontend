{
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(|index.html|flutter_bootstrap.js|flutter_service_worker.js|version.json|manifest.json|assets/\\.env)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
