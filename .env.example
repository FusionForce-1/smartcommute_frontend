# Smart Commute app settings.
# Copy to .env (git-ignored):   cp .env.example .env
# The file is packed into the app as an asset, so everything in it is
# readable by anyone who has the app: put only public values here.

# Backend the app talks to. The cloud backend works without running anything
# locally; for a local backend use http://localhost:8000 and ws://localhost:8000
# (on the Android emulator, localhost is rewritten to 10.0.2.2 automatically).
API_BASE_URL=https://smart-commute-backend.onrender.com
WS_BASE_URL=wss://smart-commute-backend.onrender.com

# Optional: several backends in order of preference. The app asks each for
# /health at start-up and uses the first one in this order that answers.
# API_BASE_URLS=https://smart-commute-backend.onrender.com,http://192.168.1.10:8000

# Optional, Android only: a real phone on the same Wi-Fi as the laptop that
# runs the backend (use the laptop's Wi-Fi IP address).
# API_BASE_URL_ANDROID=http://192.168.1.10:8000
# WS_BASE_URL_ANDROID=ws://192.168.1.10:8000

# Google OAuth "Web application" client ID, the same value as the backend's
# GOOGLE_CLIENT_ID (not a secret). Android passes it as serverClientId.
GOOGLE_WEB_CLIENT_ID=545428320814-dm6hnjft2jcdia4fkn78glhh2fn5v93i.apps.googleusercontent.com

# Optional: Google Street View photos of stops. Without it, stops show a free
# satellite snapshot instead.
# GOOGLE_MAPS_API_KEY=

# Extra logging in the debug console.
DEBUG_LOGGING=false
